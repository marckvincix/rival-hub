  "terms": {
    "title": "Terms and Privacy",
    "termsOfService": "TERMS OF SERVICE AND PRIVACY POLICY",
    "section1Title": "1. General Information",
    "section1Text1": "Rival Hub is a free digital platform for managing sports tournaments, provided by Omniaweb srls.",
    "section1Text2": "Use of the platform implies acceptance of these Terms of Service and Privacy Policy.",
    "section2Title": "2. Registration and Access",
    "section2Text1": "Users can access the platform through:",
    "section2Item1": "registration with email and password",
    "section2Item2": "authentication via third-party accounts (e.g., Google)",
    "section2Text2": "The user is responsible for the security of their login credentials.",
    "section3Title": "3. Third-Party Access",
    "section3Text1": "The platform allows access through Google accounts.",
    "section3Text2": "By using this method, the user authorizes Rival Hub to receive certain data from the provider, including:",
    "section3Item1": "first name",
    "section3Item2": "last name",
    "section3Item3": "email address",
    "section3Item4": "profile picture (if available)",
    "section3Text3": "Such data is used exclusively for authentication and account management. The platform does not have access to the user's password.",
    "section3Text4": "The use of third-party services is also subject to the provider's terms and policies.",
    "section4Title": "4. User Responsibility (Content and Third-Party Data)",
    "section4Text1": "The user is solely responsible for data entered in the app, including:",
    "section4Item1": "personal data",
    "section4Item2": "images and multimedia content",
    "section4Item3": "data relating to third parties (players, teams, collaborators)",
    "section4Text2": "The user guarantees having obtained informed consent from all individuals involved.",
    "section4Text3": "For minors, verifiable consent from parents or legal guardians is mandatory.",
    "section4Text4": "Omniaweb srls is not responsible for unlawful data entry by users.",
    "section5Title": "5. Multimedia Content",
    "section5Text1": "The user guarantees having the rights or necessary authorizations for uploaded photos and videos.",
    "section5Text2": "By uploading content, the user indemnifies Rival Hub from any liability related to:",
    "section5Item1": "privacy violations",
    "section5Item2": "image rights",
    "section6Title": "6. Prohibitions and Suspension",
    "section6Text1": "It is prohibited to:",
    "section6Item1": "use the platform for illegal purposes",
    "section6Item2": "violate third-party rights",
    "section6Item3": "upload content without authorization",
    "section6Text2": "The owner may suspend or delete accounts without notice.",
    "section7Title": "7. Limitation of Liability",
    "section7Text1": "The service is provided \"as is\".",
    "section7Text2": "Not guaranteed:",
    "section7Item1": "continuous availability",
    "section7Item2": "absence of errors or data loss",
    "section8Title": "8. Content Retention",
    "section8Item1": "Highlights: deleted after 365 days",
    "section8Item2": "Account data and content: until deletion by user",
    "section9Title": "9. Applicable Law",
    "section9Text1": "Italian law.",
    "section9Text2": "Competent court: Naples.",
    "privacyTitle": "PRIVACY POLICY",
    "privacySubtitle": "(pursuant to the General Data Protection Regulation)",
    "section10Title": "10. Data Controller",
    "section10Text1": "Omniaweb srls",
    "section10Text2": "Email: info@rivalhub.app",
    "section11Title": "11. Data Collected",
    "section11Text1": "The platform collects:",
    "section11Item1": "account data (email, name, surname)",
    "section11Item2": "data provided through Google login",
    "section11Item3": "data entered by user relating to third parties",
    "section11Item4": "multimedia content",
    "section12Title": "12. Purpose of Processing",
    "section12Text1": "Data is processed for:",
    "section12Item1": "account creation and management",
    "section12Item2": "platform usage",
    "section12Item3": "tournament management",
    "section12Item4": "security and abuse prevention",
    "section13Title": "13. Legal Basis",
    "section13Text1": "Processing is based on:",
    "section13Item1": "service execution",
    "section13Item2": "user consent",
    "section13Item3": "legitimate interest of the controller",
    "section14Title": "14. Processing Methods",
    "section14Text1": "Data is processed using IT tools and adequate security measures to ensure protection and confidentiality, as required by GDPR.",
    "section15Title": "15. Data Retention",
    "section15Item1": "account data: until deletion",
    "section15Item2": "entered data: until deletion",
    "section15Item3": "technical logs: up to 12 months",
    "section16Title": "16. Minor's Data",
    "section16Text1": "The user is responsible for entering minors' data and guarantees parental or guardian consent.",
    "section17Title": "17. Data Processors",
    "section17Text1": "The controller uses technical providers (hosting, cloud, email), appointed as data processors.",
    "section18Title": "18. Data Transfer",
    "section18Text1": "Data may be processed outside the European Economic Area, in compliance with GDPR guarantees.",
    "section19Title": "19. User Rights",
    "section19Text1": "The user may exercise:",
    "section19Item1": "access",
    "section19Item2": "rectification",
    "section19Item3": "erasure",
    "section19Item4": "restriction",
    "section19Item5": "objection",
    "section19Item6": "portability",
    "section19Text2": "They may also file a complaint with the Data Protection Authority.",
    "section20Title": "20. Consent Withdrawal",
    "section20Text1": "The user may withdraw consent at any time without affecting the lawfulness of prior processing.",
    "section21Title": "21. Data Breach",
    "section21Text1": "In case of data breach, the controller will act as required by GDPR.",
    "section22Title": "22. Cookies",
    "section22Text1": "The platform uses only necessary technical cookies.",
    "section22Text2": "No profiling or marketing cookies are used.",
    "section23Title": "23. Changes",
    "section23Text1": "The controller may modify these Terms and Privacy Policy.",
    "section23Text2": "Changes will be communicated through the platform."
  }
